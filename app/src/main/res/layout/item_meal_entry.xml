<?xml version="1.0" encoding="utf-8"?>
<!-- Một bữa trong thẻ ngày: nhãn bữa (Sáng/Trưa/Tối) + tên món. Bấm vào để mở chi tiết món.
     Màu nhãn đặt trong adapter: Sáng = meal_breakfast_*, Trưa = meal_lunch_*, Tối = meal_dinner_*. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMeal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/textMealTag"
        style="@style/Text.SoBep"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_meal_tag"
        android:backgroundTint="@color/meal_dinner_bg"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:textColor="@color/meal_dinner_fg"
        android:textSize="12sp"
        tools:text="Tối" />

    <TextView
        android:id="@+id/textRecipeTitle"
        style="@style/Text.SoBep.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        tools:text="Trứng chiên hành lá" />
</LinearLayout>
