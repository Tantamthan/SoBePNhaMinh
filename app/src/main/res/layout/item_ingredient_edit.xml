<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng nhập nguyên liệu ở màn Thêm/Sửa món: Tên | Số lượng | Đơn vị | nút xoá -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <EditText
        android:id="@+id/editName"
        style="@style/Widget.SoBep.EditText.Compact"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autofillHints=""
        android:contentDescription="@string/cd_ingredient_name"
        android:inputType="textCapSentences"
        android:maxLines="1"
        tools:text="Thịt ba chỉ" />

    <EditText
        android:id="@+id/editQuantity"
        style="@style/Widget.SoBep.EditText.Compact"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:autofillHints=""
        android:contentDescription="@string/cd_ingredient_qty"
        android:gravity="center_vertical|end"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:paddingStart="8dp"
        tools:text="500" />

    <EditText
        android:id="@+id/editUnit"
        style="@style/Widget.SoBep.EditText.Compact"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:autofillHints=""
        android:contentDescription="@string/cd_ingredient_unit"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        tools:text="g" />

    <ImageButton
        android:id="@+id/buttonDelete"
        style="@style/Widget.SoBep.IconButton"
        android:layout_width="@dimen/icon_button_small"
        android:layout_height="@dimen/icon_button_small"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/cd_delete_ingredient"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_secondary" />
</LinearLayout>
