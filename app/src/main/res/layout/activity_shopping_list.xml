<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 8 · ShoppingListActivity – Đi chợ:
     thẻ tiến độ (Đã mua x/y), ô thêm thứ cần mua, danh sách "Cần mua" và "Đã mua",
     nút "Xoá các mục đã mua". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".ui.shopping.ShoppingListActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/buttonBack"
            style="@style/Widget.SoBep.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.SoBep.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/shopping_title" />

        <ImageButton
            android:id="@+id/buttonShare"
            style="@style/Widget.SoBep.IconButton"
            android:contentDescription="@string/cd_share_list"
            android:src="@drawable/ic_share" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Tiến độ đi chợ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoBep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textSource"
                            style="@style/Text.SoBep.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="Từ thực đơn 28/9 – 4/10" />

                        <TextView
                            android:id="@+id/textProgress"
                            style="@style/Text.SoBep.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Đã mua 2/13" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressShopping"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        app:indicatorColor="@color/green_primary"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="@color/track"
                        app:trackCornerRadius="4dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="8dp"
                        tools:progress="15" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thêm thứ cần mua -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editNewItem"
                    style="@style/Widget.SoBep.EditText"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="@string/hint_add_shopping_item"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/buttonAddItem"
                    android:layout_width="@dimen/input_height"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_square_green"
                    android:contentDescription="@string/cd_add_shopping_item"
                    android:foreground="?attr/selectableItemBackground"
                    android:scaleType="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Cần mua -->
            <TextView
                android:id="@+id/textToBuyHeading"
                style="@style/Text.SoBep.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                tools:text="Cần mua · 11" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoBep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerToBuy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="11"
                    tools:listitem="@layout/item_shopping" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Đã mua -->
            <TextView
                android:id="@+id/textBoughtHeading"
                style="@style/Text.SoBep.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:textColor="@color/text_secondary"
                tools:text="Đã mua · 2" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoBep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerBought"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_shopping" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearBought"
                style="@style/Widget.SoBep.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/action_clear_bought"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
