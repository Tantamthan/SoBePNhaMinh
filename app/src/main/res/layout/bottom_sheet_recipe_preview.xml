<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet xem trước món ở màn Khám phá (dùng với BottomSheetDialog).
     Món chưa lưu: hiện nút "Lưu vào sổ của tôi".
     Món đã lưu: ẩn nút đó, hiện layoutSaved ("Món này đã có trong sổ" + nút "Mở món trong sổ"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/cd_preview_recipe"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Vạch kéo -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                style="@style/Text.SoBep.AppTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Canh trứng cà chua" />

            <TextView
                android:id="@+id/textMeta"
                style="@style/Text.SoBep.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Canh · 15 phút" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonClose"
            style="@style/Widget.SoBep.IconButton"
            android:layout_width="@dimen/icon_button_small"
            android:layout_height="@dimen/icon_button_small"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Nguyên liệu (mỗi dòng bắt đầu bằng "· ", ghép trong code) -->
    <TextView
        style="@style/Text.SoBep.BodyBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/detail_ingredients"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textIngredients"
        style="@style/Text.SoBep.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.4"
        tools:text="· Trứng gà 2 quả&#10;· Cà chua 2 quả&#10;· Hành lá 2 nhánh&#10;· Nước 800 ml" />

    <TextView
        android:id="@+id/textStepsCount"
        style="@style/Text.SoBep.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="4 bước nấu" />

    <!-- Chưa lưu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSaveToBook"
        style="@style/Widget.SoBep.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/action_save_to_book"
        app:icon="@drawable/ic_add"
        app:iconPadding="8dp" />

    <!-- Đã lưu -->
    <LinearLayout
        android:id="@+id/layoutSaved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Text.SoBep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:gravity="center_vertical"
            android:text="@string/discover_already_saved"
            android:textColor="@color/green_dark"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_check_18"
            app:drawableTint="@color/green_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenInBook"
            style="@style/Widget.SoBep.Button.OutlinedGreen"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginTop="10dp"
            android:text="@string/action_open_in_book"
            android:textAppearance="@style/TextAppearance.SoBep.Button"
            android:textSize="17sp"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
