<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 4 · CookingModeActivity – Chế độ nấu từng bước:
     thanh tiêu đề (thoát, tên món, 3/4), thanh tiến độ các bước, nội dung bước chữ to,
     vòng đếm ngược hẹn giờ, và 2 nút Bước trước / Bước tiếp ở đáy.
     keepScreenOn = true để màn hình không tự tắt khi đang nấu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:keepScreenOn="true"
    android:orientation="vertical"
    tools:context=".ui.cooking.CookingModeActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/buttonExit"
            style="@style/Widget.SoBep.IconButton"
            android:contentDescription="@string/cd_exit_cooking"
            android:src="@drawable/ic_close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.SoBep.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/cooking_label" />

            <TextView
                android:id="@+id/textRecipeTitle"
                style="@style/Text.SoBep.Subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Trứng chiên hành lá" />
        </LinearLayout>

        <TextView
            android:id="@+id/textStepProgress"
            style="@style/Text.SoBep.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_green"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textSize="15sp"
            tools:text="3/4" />
    </LinearLayout>

    <!-- Thanh tiến độ chia đoạn: mỗi bước một đoạn.
         Activity tự thêm các View dùng nền @drawable/bg_step_segment vào đây
         (layout_weight = 1, cao 6dp, cách nhau 6dp). -->
    <LinearLayout
        android:id="@+id/layoutStepSegments"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="@dimen/screen_padding_large"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:orientation="horizontal" />

    <!-- Nội dung bước + hẹn giờ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/textStepNumber"
                style="@style/Text.SoBep.BodyBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.07"
                android:textAllCaps="true"
                android:textColor="@color/green_primary"
                android:textSize="14sp"
                tools:text="Bước 3" />

            <TextView
                android:id="@+id/textStepContent"
                style="@style/Text.SoBep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:lineSpacingMultiplier="1.25"
                android:textSize="26sp"
                tools:text="Làm nóng dầu trong chảo ở lửa vừa, đổ trứng vào, chiên đến khi mặt dưới vàng." />

            <!-- Khối hẹn giờ (ẩn khi bước không có hẹn giờ) -->
            <LinearLayout
                android:id="@+id/layoutTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp">

                    <!-- Vòng tròn đếm ngược: progress = số giây đã trôi qua, max = tổng số giây -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:max="180"
                        android:progress="0"
                        app:indicatorColor="@color/accent_orange"
                        app:indicatorSize="200dp"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="@color/divider"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp"
                        tools:progress="60" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textTimerValue"
                            style="@style/Text.SoBep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_extrabold"
                            android:fontFeatureSettings="tnum"
                            android:textSize="46sp"
                            tools:text="03:00" />

                        <TextView
                            android:id="@+id/textTimerHint"
                            style="@style/Text.SoBep.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="Hẹn giờ 3 phút" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonTimerToggle"
                        style="@style/Widget.SoBep.Button.Timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonTimerReset"
                        style="@style/Widget.SoBep.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/timer_reset"
                        android:textSize="16sp"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_reset"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bước không cần hẹn giờ -->
            <TextView
                android:id="@+id/textNoTimer"
                style="@style/Text.SoBep.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_rounded_light"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/cooking_no_timer"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nhắc màn hình luôn sáng -->
    <TextView
        style="@style/Text.SoBep.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/cooking_keep_screen_on"
        app:drawableStartCompat="@drawable/ic_brightness_16"
        app:drawableTint="@color/text_secondary" />

    <!-- Bước trước / Bước tiếp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPrevStep"
            style="@style/Widget.SoBep.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/step_prev"
            android:textAppearance="@style/TextAppearance.SoBep.Button"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_back"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNextStep"
            style="@style/Widget.SoBep.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/step_next"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconPadding="6dp"
            app:iconSize="20dp" />
    </LinearLayout>

</LinearLayout>
