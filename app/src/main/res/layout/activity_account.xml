<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 12 · AccountActivity – Tài khoản:
     thẻ người đang đăng nhập (email), thẻ "Sao lưu & đồng bộ" (CN14: nút, thanh chạy, kết quả, lần gần nhất),
     ghi chú "đăng xuất không xoá món" và nút Đăng xuất. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".ui.account.AccountActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/buttonBack"
            style="@style/Widget.SoBep.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.SoBep.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/account_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Người đang đăng nhập -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoBep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_green"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_account"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.SoBep.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_signed_in_as" />

                        <TextView
                            android:id="@+id/textEmail"
                            style="@style/Text.SoBep.Subheading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="ten@vidu.com" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sao lưu & đồng bộ (CN14 – bước 8b) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SoBep.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.SoBep.Subheading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_sync_title" />

                    <TextView
                        style="@style/Text.SoBep.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/account_sync_desc" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSync"
                        style="@style/Widget.SoBep.Button.OutlinedGreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/action_sync_now" />

                    <!-- Thanh chạy khi đang đồng bộ -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/green_primary"
                        app:trackColor="@color/track"
                        app:trackCornerRadius="2dp" />

                    <!-- Kết quả lần đồng bộ vừa rồi (số món gửi lên / tải về / xoá) hoặc lỗi -->
                    <TextView
                        android:id="@+id/textSyncStatus"
                        style="@style/Text.SoBep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:textColor="@color/green_primary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Xong: gửi lên 3 món, tải về 0 món, xoá 0 món"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/textLastSync"
                        style="@style/Text.SoBep.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Đồng bộ gần nhất: 00:30, 10/11/2026" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.SoBep.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center_horizontal"
                android:text="@string/account_local_note" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSignOut"
                style="@style/Widget.SoBep.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/action_sign_out"
                android:textColor="@color/accent_orange_dark"
                app:strokeColor="@color/accent_orange_dark" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
