<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 10 · LoginActivity – Đăng nhập (CN13):
     thanh tiêu đề, lời giới thiệu, ô Email + Mật khẩu, dòng báo lỗi, nút Đăng nhập,
     vòng xoay chờ và nút chuyển sang màn Đăng ký. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".ui.auth.LoginActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/buttonBack"
            style="@style/Widget.SoBep.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.SoBep.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/login_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_large"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Text.SoBep.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_heading" />

            <TextView
                style="@style/Text.SoBep.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/login_subtitle" />

            <TextView
                style="@style/Text.SoBep.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:labelFor="@id/editEmail"
                android:text="@string/label_email" />

            <EditText
                android:id="@+id/editEmail"
                style="@style/Widget.SoBep.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />

            <!-- Lỗi của ô trên (vd email sai dạng). Ẩn khi ô hợp lệ -->
            <TextView
                android:id="@+id/textEmailError"
                style="@style/Text.SoBep.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:textColor="@color/accent_orange_dark"
                android:visibility="gone" />

            <TextView
                style="@style/Text.SoBep.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/editPassword"
                android:text="@string/label_password" />

            <EditText
                android:id="@+id/editPassword"
                style="@style/Widget.SoBep.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/hint_password_login"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />

            <!-- Lỗi của ô trên (vd email sai dạng). Ẩn khi ô hợp lệ -->
            <TextView
                android:id="@+id/textPasswordError"
                style="@style/Text.SoBep.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:textColor="@color/accent_orange_dark"
                android:visibility="gone" />

            <!-- Lỗi Firebase trả về (sai mật khẩu, mất mạng…). Ẩn khi không có lỗi -->
            <TextView
                android:id="@+id/textError"
                style="@style/Text.SoBep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_warning"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/timer_text"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="@string/error_auth_wrong_credentials"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSignIn"
                style="@style/Widget.SoBep.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_sign_in" />

            <!-- Vòng xoay chờ khi đang gửi lên Firebase -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/green_primary"
                app:indicatorSize="28dp"
                app:trackThickness="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoRegister"
                style="@style/Widget.SoBep.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/login_no_account"
                android:textColor="@color/green_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
