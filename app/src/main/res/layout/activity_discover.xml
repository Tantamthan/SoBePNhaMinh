<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 9 · DiscoverActivity – Khám phá món:
     ô tìm theo nguyên liệu, lưới 8 ô gợi ý nguyên liệu, danh sách món tìm được.
     Bấm một món sẽ mở bottom sheet xem trước (bottom_sheet_recipe_preview.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".ui.discover.DiscoverActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/buttonBack"
            style="@style/Widget.SoBep.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.SoBep.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/discover_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Ô tìm theo nguyên liệu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/editSearch"
                    style="@style/Text.SoBep.BodyLarge"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/hint_search_ingredient"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColorHint="@color/text_secondary" />
            </LinearLayout>

            <!-- Gợi ý theo nguyên liệu -->
            <TextView
                style="@style/Text.SoBep.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_large"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/discover_suggest_heading" />

            <!-- Lưới 2 cột; mỗi ô margin 5dp nên khoảng cách giữa 2 ô = 10dp -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="11dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="8"
                tools:listitem="@layout/item_discover_tile" />

            <!-- Tiêu đề kết quả + số món -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_large"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textResultHeading"
                    style="@style/Text.SoBep.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_heading_all" />

                <TextView
                    android:id="@+id/textResultCount"
                    style="@style/Text.SoBep.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="9 món" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/screen_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="6"
                tools:listitem="@layout/item_discover_recipe" />

            <!-- Không tìm thấy món -->
            <TextView
                android:id="@+id/textEmpty"
                style="@style/Text.SoBep.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:background="@drawable/bg_dashed_empty"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="28dp"
                android:text="@string/discover_empty"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
