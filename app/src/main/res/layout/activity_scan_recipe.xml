<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 6 · ScanRecipeActivity – Quét công thức:
     ảnh đã chụp, nút Chụp lại / Chọn ảnh khác, trạng thái đọc chữ,
     ô chữ nhận dạng được (cho sửa) và nút "Dùng kết quả này" ở đáy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".ui.scan.ScanRecipeActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/buttonBack"
            style="@style/Widget.SoBep.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.SoBep.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/scan_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Ảnh đã chụp -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardBackgroundColor="@color/scan_photo_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <!-- Icon giữ chỗ khi chưa có ảnh; Activity thay bằng ảnh thật -->
                <ImageView
                    android:id="@+id/imagePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_scanned_photo"
                    android:scaleType="center"
                    android:src="@drawable/ic_image"
                    app:tint="@color/text_disabled" />

                <TextView
                    style="@style/Text.SoBep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_badge_white"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/scan_photo_badge"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Chụp lại / Chọn ảnh khác -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRetake"
                    style="@style/Widget.SoBep.Button.OutlinedGreen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/action_retake"
                    app:icon="@drawable/ic_camera" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPickOther"
                    style="@style/Widget.SoBep.Button.OutlinedGreen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/action_pick_other_photo"
                    app:icon="@drawable/ic_image" />
            </LinearLayout>

            <!-- Trạng thái đọc chữ: đang đọc (vòng xoay) hoặc đã xong (dấu tích) -->
            <LinearLayout
                android:id="@+id/layoutStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_success"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressReading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/green_dark"
                    app:indicatorSize="18dp"
                    app:trackThickness="2dp" />

                <ImageView
                    android:id="@+id/imageStatusDone"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green_dark" />

                <TextView
                    android:id="@+id/textStatus"
                    style="@style/Text.SoBep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/scan_done"
                    android:textColor="@color/green_dark"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Chữ nhận dạng được -->
            <TextView
                style="@style/Text.SoBep.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/editScannedText"
                android:text="@string/label_scanned_text" />

            <EditText
                android:id="@+id/editScannedText"
                style="@style/Widget.SoBep.EditText.Multiline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:lineSpacingMultiplier="1.3"
                android:minLines="8"
                tools:text="Thịt kho trứng&#10;500g thịt ba chỉ&#10;4 quả trứng vịt&#10;400ml nước dừa&#10;1. Thịt cắt miếng, ướp nước mắm, đường&#10;2. Luộc trứng, bóc vỏ&#10;3. Kho lửa nhỏ đến khi thịt mềm" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thanh dưới: chú thích + nút dùng kết quả -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_app"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.SoBep.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/scan_footer_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUseResult"
            style="@style/Widget.SoBep.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_use_result" />
    </LinearLayout>

</LinearLayout>
