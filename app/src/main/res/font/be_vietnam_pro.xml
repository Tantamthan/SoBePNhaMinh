<?xml version="1.0" encoding="utf-8"?>
<!-- Họ font Be Vietnam Pro (giấy phép SIL OFL), dùng cho toàn app.
     Các độ đậm 500/600/800 được gọi trực tiếp bằng @font/be_vietnam_pro_medium,
     @font/be_vietnam_pro_semibold, @font/be_vietnam_pro_extrabold trong styles. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/be_vietnam_pro_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/be_vietnam_pro_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/be_vietnam_pro_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/be_vietnam_pro_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
