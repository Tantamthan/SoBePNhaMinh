<?xml version="1.0" encoding="utf-8"?>
<!-- Nút "Thêm nguyên liệu / Thêm bước": viền nét đứt xanh, gợn sóng khi chạm -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/green_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/green_primary"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</ripple>
