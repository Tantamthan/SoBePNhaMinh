<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Chụp ảnh trang công thức ở màn Quét. Quyền "nguy hiểm" → phải xin thêm lúc chạy -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Máy không có camera vẫn cài được app (khi đó chỉ chọn ảnh có sẵn) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- CN13: Firebase Auth gửi email / mật khẩu lên máy chủ Google. Quyền thường, không cần xin lúc chạy -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoBepNhaMinh">

        <!-- Màn 1 · Splash: màn mở đầu tiên khi bấm icon app (MAIN + LAUNCHER) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SoBepNhaMinh.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Các màn còn lại chỉ mở từ bên trong app nên exported="false" -->
        <!-- Màn 2 · Sổ công thức -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn 3 · Chi tiết món -->
        <activity
            android:name=".ui.detail.RecipeDetailActivity"
            android:exported="false" />

        <!-- Màn 4 · Chế độ nấu -->
        <activity
            android:name=".ui.cooking.CookingModeActivity"
            android:exported="false" />

        <!-- Màn 5 · Thêm / sửa món -->
        <activity
            android:name=".ui.addedit.AddEditRecipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn 6 · Quét công thức -->
        <activity
            android:name=".ui.scan.ScanRecipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn 7 · Thực đơn tuần -->
        <activity
            android:name=".ui.mealplan.MealPlanActivity"
            android:exported="false" />

        <!-- Màn 8 · Danh sách đi chợ -->
        <activity
            android:name=".ui.shopping.ShoppingListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn 9 · Khám phá món -->
        <activity
            android:name=".ui.discover.DiscoverActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn 10 · Đăng nhập (CN13) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn 11 · Đăng ký (CN13) -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn 12 · Tài khoản -->
        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false" />

        <!-- Cho app Camera ghi ảnh vào file của app mình qua Uri content:// (xem util/ImageStorage) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
